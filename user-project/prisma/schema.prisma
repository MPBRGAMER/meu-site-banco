generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Emprestimo {
  id             String   @id @default(cuid())
  player         String
  item           String
  quantidade     Int
  dataEmprestimo DateTime
  tipoMembro     String   @default("comum")
  status         String   @default("pendente")
  dataPagamento  DateTime?
  itemPagamento  String?
  quantidadePaga Int?
}

model Investidor {
  id         String   @id @default(cuid())
  nome       String
  dataEntrada DateTime @default(now())
  status     String   @default("ativo")
  observacao String?
  ordem      Int      @default(0)
}

model TabelaTroca {
  id                String  @id @default(cuid())
  itemBase          String
  quantidadeBase    Int
  itemResultado     String
  quantidadeResultado Int
  categoria         String?
}

model TrocaRegistro {
  id               String   @id @default(cuid())
  player           String
  itemEnviado      String
  quantidadeEnviada Int
  itemRecebido     String
  quantidadeRecebida Int
  tipoMembro       String
  taxaAplicada     Int
  lucroBanco       Int
  data             DateTime @default(now())
}

model CompraVenda {
  id           String   @id @default(cuid())
  tipo         String
  player       String
  item         String
  quantidade   Int
  itemPagamento String?
  valor        Float
  data         DateTime @default(now())
  observacao   String?
}

model CaixaRegistro {
  id        String   @id @default(cuid())
  tipo      String
  descricao String
  item      String
  quantidade Int
  valor     Float?
  data      DateTime @default(now())
  origem    String
}

model Doador {
  id         String   @id @default(cuid())
  nome       String
  item       String
  quantidade Int
  data       DateTime @default(now())
  ordem      Int      @default(0)
}

model Leilao {
  id               String    @id @default(cuid())
  donoItem         String
  nomeItem         String
  imagemUrl        String?
  quantidade       Int       @default(1)
  valorInicial     Float
  moedaAceita      String
  taxaCasa         Int       @default(15)
  status           String    @default("ativo")
  dataCriacao      DateTime  @default(now())
  dataExpiracao    DateTime
  dataUltimoLance  DateTime?
  vencedor         String?
  valorVencedor    Float?
  tipoMembroVencedor String?
  tipoOrigem       String    @default("comum")
  lances           Lance[]
}

model Lance {
  id       String   @id @default(cuid())
  leilaoId String
  jogador  String
  valor    Float
  data     DateTime @default(now())
  leilao   Leilao   @relation(fields: [leilaoId], references: [id], onDelete: Cascade)
}

model Sorteio {
  id           String    @id @default(cuid())
  nomeItem     String
  quantidade   Int
  duracaoMinutos Int
  status       String    @default("ativo")
  dataCriacao  DateTime  @default(now())
  dataFim      DateTime?
  ganhador     String?
  participantes ParticipanteSorteio[]
}

model ParticipanteSorteio {
  id        String   @id @default(cuid())
  sorteioId String
  jogador   String
  data      DateTime @default(now())
  sorteio   Sorteio  @relation(fields: [sorteioId], references: [id], onDelete: Cascade)
}

model Loterica {
  id              String    @id @default(cuid())
  status          String    @default("vendas_abertas")
  valorNumero     Float
  moedaAceita     String
  premioMinimo    Float     @default(0)
  premioAcumulado Float     @default(0)
  duracaoMinutos  Int       @default(60)
  dataCriacao     DateTime  @default(now())
  dataFimVendas   DateTime?
  dataSorteio     DateTime?
  numeroSorteado  Int?
  ganhador        String?
  valorPremio     Float     @default(0)
  arrecadadoTotal Float     @default(0)
  numeros         NumeroLoterica[]
}

model NumeroLoterica {
  id         String   @id @default(cuid())
  lotericaId String
  numero     Int
  comprador  String?
  dataCompra DateTime?
  loterica   Loterica @relation(fields: [lotericaId], references: [id], onDelete: Cascade)
}

model PriceReport {
  id          String   @id @default(cuid())
  itemId      String
  itemName    String
  nickname    String
  steelQty    Int
  steelPrice  Int
  cementQty   Int
  cementPrice Int
  data        DateTime @default(now())
}

model ItemOverride {
  id        String  @id @default(cuid())
  itemId    String  @unique
  name      String?
  categoryId String?
  img       String?
  wikiLink  String?
  steel     String?
  cement    String?
  rarity    String?
  demand    String?
  notes     String?
  action    String  // "edit" or "remove"
  data      DateTime @default(now())
}

model ChatMensagem {
  id        String   @id @default(cuid())
  canal     String
  salaId    String?
  autor     String
  conteudo  String
  data      DateTime @default(now())
  isAdmin   Boolean  @default(false)
  sala      ChatSala? @relation(fields: [salaId], references: [id], onDelete: Cascade)
}

model ChatSala {
  id          String         @id @default(cuid())
  nome        String
  criadoPor   String
  senha       String?
  dataCriacao DateTime       @default(now())
  mensagens   ChatMensagem[]
}

model ItemCatalogo {
  id        String   @id @default(cuid())
  nome      String   @unique
  arquivo   String
  data      DateTime @default(now())
}

model Propaganda {
  id        String   @id @default(cuid())
  slotId    String   @unique
  codigo    String   @default("")
  updatedAt DateTime @updatedAt
}

model Moderador {
  id          String    @id @default(cuid())
  nome        String
  usuario     String    @unique
  senha       String
  permissoes  String
  token       String?
  tokenExpira DateTime?
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
}
